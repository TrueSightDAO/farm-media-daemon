[Unit]
Description=Media Archive Daemon - intake front door (claim dropped zips from /media/to_process)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
ExecStart=/opt/truesight_autopilot/.venv/bin/python /opt/truesight_autopilot/farm_media_daemon/farm_media_intake.py --config /opt/truesight_autopilot/media_archive_daemon_config.yaml --once
