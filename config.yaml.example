# Farm Media Daemon — config template
# Copy to /opt/truesight_autopilot/media_archive_daemon_config.yaml (never commit real creds)

# Global daily upload budget across ALL farms (YouTube API "Video Uploads per day")
# Unverified OAuth project: ~6/day. Verified: up to 100/day. Reset ~07:00 UTC.
daily_budget: 6

# YouTube project(s) — add more entries to scale cap (multi-project support planned)
projects:
  - name: truesight-main
    credentials: /opt/truesight_autopilot/config/youtube/youtube_token.json
    client_secrets: /opt/truesight_autopilot/config/youtube/client_secret.json

# Inboxes the daemon watches
inboxes:
  - farm_id: cleide
    path: /home/ubuntu/media_archive_inbox/farm-media/cleide
    priority: 2
  - farm_id: paulo-la-do-sitio
    path: /home/ubuntu/media_archive_inbox/farm-media/paulo-la-do-sitio
    priority: 1

# Raw archive worker (farm_media_archive.py) — originals -> S3 media.agroverse.shop
# Raws follow bucket lifecycle (STANDARD_IA @30d -> DEEP_ARCHIVE @180d);
# previews/ has NO lifecycle rule so previews stay HOT.
archive:
  bucket: media.agroverse.shop
  region: us-east-1
  preview_frame_frac: 0.25   # frame at 25% duration
  roots:
    # FORM 1 — extracted directory of originals:
    - farm_id: cleide
      path: /home/ubuntu/cleide_media
    - farm_id: paulo-la-do-sitio
      path: /home/ubuntu/la_do_sitio_work

    # FORM 2 — zip of originals (archives each ENTRY individually,
    # never the zip blob — see MEDIA_ARCHIVE_PIPELINE.md ZIP HANDLING RULE).
    # Each real media file inside is streamed to temp, sha256'd, given a
    # captured_at + preview frame, uploaded to raw/<farm>/ + previews/<farm>/,
    # then a durable state file <zip>.archive.json is written (resume-safe).
    # __MACOSX/ and ._ AppleDouble junk entries are skipped automatically.
    - farm_id: cacao-variety-parap
      zip: /home/ubuntu/cacao_variety_parap.zip
      extensions: [.MOV, .mov, .mp4, .HEIC, .heic, .JPG, .jpg]

# Sleep window: uploads pause 07:00-07:05 UTC for quota reset (configurable)
quota_reset_utc: "07:05"

# Upload defaults (per-sidecar override wins)
defaults:
  privacy: public
  tags: [cacao, agroverse]
  description_footer: "Cacao farm visit, CEPOTX, Para, Brazil."
